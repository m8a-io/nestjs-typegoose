{
  "name": "@m8a/nestjs-typegoose",
  "version": "13.1.0",
  "description": "A nestjs module wrapper for typegoose",
  "homepage": "https://nestjs-typegoose.m8a.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m8a-io/nestjs-typegoose.git"
  },
  "license": "MIT",
  "author": "Kyle Pfromer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "_phase:build": "tsc -p tsconfig.build.json",
    "_phase:test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "build": "tsc -p tsconfig.build.json",
    "commit": "git cz",
    "coverage": "yarn run test:cov && cat ./coverage/lcov.info | coveralls",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint --fix ./",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "jest": {
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "resetMocks": true,
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "dependencies": {
    "is-class": "0.0.9"
  },
  "devDependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "~12.6.0",
    "@nestjs/testing": "12.6.0",
    "@rushstack/eslint-config": "4.4.0",
    "@typegoose/typegoose": "13.3.0",
    "@types/jest": "30.0.0",
    "@types/supertest": "6.0.3",
    "coveralls": "3.1.1",
    "eslint": "8.57.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "mongodb-memory-server": "10.2.0",
    "mongoose": "9.6.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "superagent": "10.2.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@typegoose/typegoose": "^13.0.0",
    "mongoose": "^9.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
